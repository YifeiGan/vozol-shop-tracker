rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profilePath() {
      return /databases/$(database)/documents/profiles/$(request.auth.uid);
    }

    function me() {
      return get(profilePath()).data;
    }

    function hasProfile() {
      return signedIn() && exists(profilePath());
    }

    function isManager() {
      return hasProfile() && me().role == 'manager';
    }

    function isTeammate(userId) {
      return exists(/databases/$(database)/documents/profiles/$(userId))
        && get(/databases/$(database)/documents/profiles/$(userId)).data.team_id == me().team_id;
    }

    function canAccessOwnedShop(userId) {
      return hasProfile() && (
        request.auth.uid == userId ||
        (isManager() && isTeammate(userId))
      );
    }

    function canAccessLegacyShop(shopId) {
      let shop = get(/databases/$(database)/documents/shops/$(shopId)).data;
      return hasProfile() && (
        shop.assigned_to == request.auth.uid ||
        (isManager() && shop.team_id == me().team_id)
      );
    }

    match /profiles/{userId} {
      allow read: if signedIn() && (
        request.auth.uid == userId ||
        (isManager() && resource.data.team_id == me().team_id)
      );

      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role == 'sales'
        && request.resource.data.team_id is string
        && request.resource.data.active == true
        && request.resource.data.full_name is string
        && request.resource.data.email is string;

      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role == resource.data.role
        && request.resource.data.team_id == resource.data.team_id
        && request.resource.data.active == resource.data.active;

      match /shops/{shopId} {
        allow read: if canAccessOwnedShop(userId);

        allow create: if hasProfile()
          && request.resource.data.team_id == me().team_id
          && request.resource.data.assigned_to == userId
          && (
            request.auth.uid == userId ||
            (isManager() && isTeammate(userId))
          );

        allow update: if canAccessOwnedShop(userId)
          && request.resource.data.team_id == resource.data.team_id
          && request.resource.data.assigned_to == userId;

        allow delete: if isManager() && resource.data.team_id == me().team_id;

        match /visits/{visitId} {
          allow read, create, update, delete: if canAccessOwnedShop(userId);
        }
      }
    }

    // Legacy top-level shops: read + delete only so the app can move them under profiles.
    match /shops/{shopId} {
      allow read: if hasProfile() && (
        resource.data.assigned_to == request.auth.uid ||
        (isManager() && resource.data.team_id == me().team_id)
      );

      allow delete: if hasProfile() && (
        resource.data.assigned_to == request.auth.uid ||
        (isManager() && resource.data.team_id == me().team_id)
      );

      match /visits/{visitId} {
        allow read, delete: if canAccessLegacyShop(shopId);
      }
    }
  }
}
